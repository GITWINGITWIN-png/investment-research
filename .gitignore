# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data the system creates or fetches: binary files that grow every day, not suited to git
#
# ⚠️ Important: data/raw/ is a **point-in-time store that cannot be rebuilt later**;
# lose it and it is gone for good, so it needs a separate backup (see scripts/backup.sh)
data/

# Public edition: the briefs, plans and scan results the system writes at run time stay local
Journal/
