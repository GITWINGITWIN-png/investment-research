# User-level anacron (no root needed): runs jobs missed while the machine was off
#
# How it works: cron calls anacron every hour (05:05 to 23:05) and at boot;
# anacron checks in its spool when each job last ran, and runs it if its period has passed,
# so whenever the machine is switched on that day, the day's data is collected; left on overnight, the job runs at 05:05
#
# This anacron (2.3 on Debian/Ubuntu) has no START_HOURS_RANGE,
# so not running between 00:00 and 04:59 (while the US market is open) is controlled from crontab instead
SHELL=/bin/bash
PATH=/home/you/.local/bin:/usr/local/bin:/usr/bin:/bin
HOME=/home/you
LANG=C.UTF-8
MAILTO=""

# period(days)  delay(min)  job name        command
1              2            finbg-morning   /home/you/investment-research/scripts/morning.sh
7              20           finbg-backup    /home/you/investment-research/scripts/backup.sh
